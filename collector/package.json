{
  "name": "radar-ofertas-collector",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "tsx src/run.ts",
    "collect:meta": "tsx src/run.ts --only=meta",
    "collect:google": "tsx src/run.ts --only=google",
    "collect:ra": "tsx src/run.ts --only=ra",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "playwright": "^1.47.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
